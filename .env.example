PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/date_app_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=1h

# Premium & Feature Controls
PREMIUM_ENFORCEMENT=false

# Google OAuth Client ID (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here

# ✉️ Personal Gmail SMTP Credentials (For sending real OTP emails directly from your personal Gmail)
# Note: Use a 16-character Google "App Password" (NOT your main Gmail password)
# Generate from: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_USER=your_personal_email@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM_NAME="Gandhinagar Dating"

# Cloudinary Storage Credentials (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
